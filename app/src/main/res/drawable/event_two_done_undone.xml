<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">


    <item android:left="50dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/done" />
            <size
                android:width="100dp"
                android:height="100dp" />
        </shape>
    </item>

    <item android:left="150dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/undone" />
            <size
                android:width="100dp"
                android:height="100dp" />
        </shape>
    </item>
    <item android:left="250dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/dark_background" />
            <size
                android:width="50dp"
                android:height="100dp" />
        </shape>
    </item>


</layer-list>